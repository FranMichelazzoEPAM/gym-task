<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" 
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

  <persistence-unit name="gymPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <!-- List entity classes explicitly (optional if scanning is configured) -->
    <class>gym.domain.User</class>
    <class>gym.domain.Trainer</class>
    <class>gym.domain.Trainee</class>
    <class>gym.domain.Training</class>
    <class>gym.domain.TrainingType</class>

    <properties>
      <!-- JDBC connection (H2 in-memory) -->
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:gymdb;DB_CLOSE_DELAY=-1"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value=""/>

      <!-- Hibernate / JPA provider settings -->
      <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
      <property name="hibernate.hbm2ddl.auto" value="update"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.format_sql" value="true"/>

      <!-- Use Jakarta transaction API names if needed -->
      <property name="jakarta.persistence.schema-generation.database.action" value="none"/>

      <!-- Optional: configure SQL comments and JDBC batch size for dev -->
      <property name="hibernate.use_sql_comments" value="true"/>
      <property name="hibernate.jdbc.batch_size" value="50"/>
    </properties>
  </persistence-unit>
</persistence>
